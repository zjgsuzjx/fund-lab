# Local PostgreSQL installed on your computer. Copy this file to .env.
# PowerShell database scripts read these PG* settings; environment variables win.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=simulate_alipay
PGUSER=postgres
# Leave blank to let db-shell.ps1 ask for the password, or set it locally.
PGPASSWORD=
# Optional directory containing psql.exe; otherwise use PATH / Windows registry.
PG_BIN=
